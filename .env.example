# ⚠️ Para chamadas AUTENTICADAS, NEXT_PUBLIC_API_URL PRECISA ser "/api-backend".
#
# O axios do front nao anexa Authorization: quem injeta o token do cookie
# HttpOnly e' o proxy em src/app/api-backend/[...path]. Apontando direto para a
# API (ex.: http://localhost:3333), o login funciona e TODA chamada seguinte
# responde 401 — o app parece logar e cair sozinho no instante seguinte.
#
# API_URL_INTERNAL e' o destino real do proxy, server-side.

# Desenvolvimento local
NEXT_PUBLIC_API_URL="/api-backend"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PROJECT_NAME="Health Voice"

# Projeto Vercel health-voice-homolog:
# NEXT_PUBLIC_API_URL="/api-backend"
# NEXT_PUBLIC_APP_URL="https://health-voice-homolog.vercel.app"
# API_URL_INTERNAL="https://api-homolog.healthvoice.com.br"
API_URL_INTERNAL="http://localhost:3333"
OPEN_ROUTER_KEY=""

# Nunca publicar segredos em variáveis NEXT_PUBLIC_*.
# OPEN_ROUTER_KEY deve existir somente no servidor (Vercel), nunca em NEXT_PUBLIC_*.
