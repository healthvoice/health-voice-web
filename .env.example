# =============================================================================
# health-voice-web — variáveis de ambiente
# NEXT_PUBLIC_* entra no bundle do navegador: nunca use esse prefixo em segredo.
# =============================================================================

# API do produto (desenvolvimento local: http://localhost:3333)
NEXT_PUBLIC_API_URL="http://localhost:3333"
# Destino interno opcional usado por rotas server-side e pelo proxy da
# homologação. HTTPS é obrigatório fora de localhost/127.0.0.1/::1: a
# comunicação Vercel -> VPS transporta JWT, dados pessoais e de pagamento.
API_URL_INTERNAL="http://localhost:3333"

# Identidade do app
PROJECT_NAME="Health Voice"
PROJECT_VOICE="Health Voice"
NEXT_PUBLIC_APP_NAME="Health Voice"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# PRIMARY_COLOR=""

# Login social
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_CLIENT_ID=""

# OpenRouter — somente server-side, usado pelas rotas /api/chat/* e
# /api/openrouter/*. Nunca exponha esta chave com prefixo NEXT_PUBLIC_.
# A chave precisa ter `limit` > 0 e `limit_reset` diário, semanal ou mensal
# configurados no OpenRouter. As rotas falham fechado se o provedor não
# confirmar esse teto distribuído ou se o saldo do período estiver esgotado.
OPENROUTER_API_KEY=""
# O saldo restante tambem precisa ser >= 0.50; abaixo disso, o proxy bloqueia
# novas chamadas antes de enviar conteudo ao provedor.
# Modelo opcional do chat popup (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=""
# Lista adicional, separada por virgulas, de modelos aceitos pela rota /api/chat.
# O navegador nao pode escolher modelos fora desta allowlist server-side.
# OPENROUTER_ALLOWED_MODELS=""

# Tracking de sessão no navegador (milissegundos; default: 30000)
# NEXT_PUBLIC_SESSION_PING_INTERVAL="30000"
